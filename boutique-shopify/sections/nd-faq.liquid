{% comment %}
  FAQ en accordéons accessibles (<details>), avec données structurées FAQPage.
{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding nd-faq">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'category' -%}
          <h2 class="h3 nd-faq__category" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</h2>
        {%- when 'question' -%}
          <div class="accordion" {{ block.shopify_attributes }}>
            <details id="Faq-{{ block.id }}">
              <summary>
                <h3 class="accordion__title h4">{{ block.settings.question | escape }}</h3>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.structured_data -%}
  {%- capture faq_items -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' and block.settings.question != blank -%}
        ,{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_items | strip | remove_first: ',' }}]}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "checkbox", "id": "structured_data", "label": "Ajouter les données structurées FAQ (SEO)", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 36 }
  ],
  "blocks": [
    { "type": "category", "name": "Catégorie", "settings": [{ "type": "text", "id": "title", "label": "Titre de catégorie", "default": "Livraison" }] },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Votre question ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre réponse.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
