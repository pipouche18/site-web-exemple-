{% comment %} Page 404 soignée : message, tuiles vers les collections, retour à l'accueil. {% endcomment %}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width nd-404">
    <p class="nd-kicker">Erreur 404</p>
    <h1 class="h0 nd-404__title">{{ section.settings.heading | escape }}</h1>
    <p class="nd-404__text">{{ section.settings.text | escape }}</p>
    {%- render 'nd-collection-tiles', handles: section.settings.handles, exclude: '', sizes: '(min-width: 750px) 25vw, 50vw' -%}
    <p class="nd-404__cta"><a href="{{ routes.root_url }}" class="button">Retour à l'accueil</a></p>
  </div>
</div>

{% schema %}
{
  "name": "Page 404",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Oups… cette page n'existe plus" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Mais nos parures, elles, vous attendent. Voici quelques idées pour continuer :" },
    { "type": "text", "id": "handles", "label": "Collections (identifiants séparés par des virgules)", "default": "parures, couvre-lits, style-japonais, style-romantique" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" }
  ]
}
{% endschema %}
