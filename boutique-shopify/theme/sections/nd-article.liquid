{% comment %} Texte long et lisible (pages Entretien, Livraison, À propos…) : intertitres + paragraphes. {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding nd-article">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'note' -%}
          <div class="rte nd-article__note" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Texte (article)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 36 }
  ],
  "blocks": [
    { "type": "heading", "name": "Intertitre", "settings": [{ "type": "text", "id": "heading", "label": "Intertitre", "default": "Intertitre" }] },
    { "type": "text", "name": "Paragraphe", "settings": [{ "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Votre texte.</p>" }] },
    { "type": "note", "name": "Encadré", "settings": [{ "type": "richtext", "id": "text", "label": "Texte encadré", "default": "<p>Information importante.</p>" }] }
  ],
  "presets": [{ "name": "Texte (article)", "blocks": [{ "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
