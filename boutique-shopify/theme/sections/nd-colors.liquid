{% comment %} « Acheter par couleur » : pastilles rondes cliquables (lien vers une recherche ou une collection filtrée). {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .nd-colors__head { text-align: center; margin-bottom: 3.2rem; }
  .nd-colors__list { display: flex; gap: 2.4rem; margin: 0; padding: 0 0 .8rem; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; justify-content: flex-start; }
  @media screen and (min-width: 750px) { .nd-colors__list { justify-content: center; gap: 4rem; overflow: visible; } }
  .nd-colors__item { flex: none; scroll-snap-align: start; }
  .nd-colors__link { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; text-decoration: none; color: inherit; }
  .nd-colors__dot { width: 8.8rem; height: 8.8rem; border-radius: 50%; border: 1px solid rgba(var(--color-foreground), .15); box-shadow: inset 0 0 0 6px rgb(var(--color-background)); transition: transform .3s ease, box-shadow .3s ease; }
  .nd-colors__link:hover .nd-colors__dot, .nd-colors__link:focus-visible .nd-colors__dot { transform: scale(1.06); box-shadow: inset 0 0 0 3px rgb(var(--color-background)); }
  .nd-colors__name { font-size: 1.3rem; letter-spacing: .14em; text-transform: uppercase; }
  .nd-colors__link:focus-visible { outline: none; }
  .nd-colors__link:focus-visible .nd-colors__name { text-decoration: underline; }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="nd-colors__head">
      {%- if section.settings.kicker != blank -%}<p class="nd-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    <ul class="nd-colors__list" role="list">
      {%- for block in section.blocks -%}
        {%- capture link -%}{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- else -%}{{ routes.search_url }}?q={{ block.settings.name | url_encode }}&type=product{%- endif -%}{%- endcapture -%}
        <li class="nd-colors__item" {{ block.shopify_attributes }}>
          <a class="nd-colors__link" href="{{ link }}">
            <span class="nd-colors__dot" style="background: {{ block.settings.color }};" aria-hidden="true"></span>
            <span class="nd-colors__name">{{ block.settings.name | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Acheter par couleur",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Nos teintes" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisir par couleur" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Couleur",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom (tel qu'écrit dans vos produits)", "default": "Sable" },
        { "type": "color", "id": "color", "label": "Teinte de la pastille", "default": "#D8C3A5" },
        { "type": "url", "id": "link", "label": "Lien (facultatif)", "info": "Vide : recherche automatique des produits de cette couleur." }
      ]
    }
  ],
  "presets": [{ "name": "Acheter par couleur", "blocks": [{ "type": "color" }] }]
}
{% endschema %}
