{% comment %} Arguments numérotés (01, 02, 03) avec grand chiffre serif. {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .nd-features__head { max-width: 60rem; margin: 0 auto 4rem; text-align: center; }
  .nd-features__grid { display: grid; gap: 3.2rem; margin: 0; padding: 0; list-style: none; }
  @media screen and (min-width: 750px) { .nd-features__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr); gap: 4.8rem; } }
  .nd-feature { border-top: 1px solid rgba(var(--color-foreground), .25); padding-top: 2rem; }
  .nd-feature__num { display: block; font-family: var(--font-heading-family); font-size: 4.8rem; line-height: 1; margin-bottom: 1.6rem; color: rgb(var(--color-button)); }
  .nd-feature__title { margin: 0 0 1rem; font-size: 2.2rem; }
  .nd-feature__text { margin: 0; color: rgba(var(--color-foreground), .8); }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="nd-features__head">
      {%- if section.settings.kicker != blank -%}<p class="nd-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    <ul class="nd-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="nd-feature" {{ block.shopify_attributes }}>
          <span class="nd-feature__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="nd-feature__title">{{ block.settings.title | escape }}</h3>
          <div class="nd-feature__text rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Arguments numérotés",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Pourquoi nous" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi nos parures" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Argument",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Un argument" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une phrase courte.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Arguments numérotés", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
