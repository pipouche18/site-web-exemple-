{% comment %} Bloc réassurance : icônes + courts messages (paiement, retours, délai…). {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .nd-reassurance__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.4rem 1.6rem; margin: 0; padding: 0; list-style: none; }
  @media screen and (min-width: 990px) { .nd-reassurance__list { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr); } }
  .nd-reassurance__item { text-align: center; }
  .nd-reassurance__item .svg-wrapper { width: 2.8rem; height: 2.8rem; margin: 0 auto 1rem; }
  .nd-reassurance__title { margin: 0 0 0.4rem; font-size: 1.6rem; font-weight: 600; font-family: var(--font-body-family); }
  .nd-reassurance__text { margin: 0; font-size: 1.4rem; color: rgba(var(--color-foreground), 0.8); }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="nd-reassurance__list" role="list">
      {%- for block in section.blocks -%}
        <li class="nd-reassurance__item" {{ block.shopify_attributes }}>
          {% render 'icon-accordion', icon: block.settings.icon %}
          <p class="nd-reassurance__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}
            <p class="nd-reassurance__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Réassurance",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "lock",
          "options": [
            { "value": "lock", "label": "Cadenas" },
            { "value": "return", "label": "Retour" },
            { "value": "truck", "label": "Camion" },
            { "value": "box", "label": "Colis" },
            { "value": "chat_bubble", "label": "Bulle" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "washing", "label": "Lavage" },
            { "value": "heart", "label": "Cœur" },
            { "value": "price_tag", "label": "Étiquette" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Paiement sécurisé" },
        { "type": "inline_richtext", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Réassurance",
      "blocks": [
        { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé" } },
        { "type": "item", "settings": { "icon": "return", "title": "14 jours pour changer d'avis" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Livraison en 10 à 18 jours ouvrés" } }
      ]
    }
  ]
}
{% endschema %}
