{% comment %}
  Guide des tailles interactif : on choisit la largeur de son lit, la réponse
  s'affiche instantanément avec un schéma à l'échelle (lit + housse).
  Sans JavaScript, toutes les réponses restent lisibles dans la liste.
{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
{%- liquid
  assign d = section.blocks[section.settings.default_index]
  if d == blank
    assign d = section.blocks.first
  endif
-%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding nd-finder" data-nd-finder style="--bw: {{ d.settings.bed_w | default: 140 }}; --bl: {{ d.settings.bed_l | default: 190 }}; --cw: {{ d.settings.cover_w | default: 200 }}; --cl: {{ d.settings.cover_l | default: 200 }};">
    <div class="nd-finder__head">
      {%- if section.settings.kicker != blank -%}<p class="nd-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte nd-finder__intro">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <fieldset class="nd-seg" role="radiogroup">
      <legend class="nd-seg__legend">{{ section.settings.question | escape }}</legend>
      <div class="nd-seg__track">
        <span class="nd-seg__thumb" aria-hidden="true"></span>
        {%- for block in section.blocks -%}
          <label class="nd-seg__option" {{ block.shopify_attributes }}>
            <input type="radio" name="nd-bed-{{ section.id }}" value="{{ forloop.index0 }}" {% if forloop.index0 == section.settings.default_index %}checked{% endif %} class="visually-hidden">
            <span>{{ block.settings.label | escape }}</span>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>

    <div class="nd-finder__result">
      <figure class="nd-finder__diagram" aria-hidden="true">
        <div class="nd-finder__stage{% if d.settings.bed_w < 120 %} is-single{% endif %}">
          <span class="nd-d nd-d--head"></span>
          <span class="nd-d nd-d--mattress"></span>
          <span class="nd-d nd-d--pillows"><span></span><span></span></span>
          <span class="nd-d nd-d--cover"></span>
          <span class="nd-d nd-d--outline"></span>
          <span class="nd-d nd-d--dim-w"><span data-dim-w>{{ d.settings.cover_w }} cm</span></span>
          <span class="nd-d nd-d--dim-l"><span data-dim-l>{{ d.settings.cover_l }} cm</span></span>
        </div>
        <figcaption class="nd-finder__legend"><span class="nd-finder__key nd-finder__key--cover"></span>Housse de couette <span class="nd-finder__key nd-finder__key--bed"></span>Matelas</figcaption>
      </figure>

      <ol class="nd-finder__answers" role="list">
        {%- for block in section.blocks -%}
          <li class="nd-finder__answer" data-index="{{ forloop.index0 }}"
              data-bed-w="{{ block.settings.bed_w }}" data-bed-l="{{ block.settings.bed_l }}"
              data-cover-w="{{ block.settings.cover_w }}" data-cover-l="{{ block.settings.cover_l }}"
              {% if forloop.index0 == section.settings.default_index %}aria-current="true"{% endif %}>
            <p class="nd-finder__bed-label">{{ block.settings.label | escape }} · matelas {{ block.settings.bed_w }}×{{ block.settings.bed_l }} cm</p>
            <p class="nd-finder__main">Housse <strong>{{ block.settings.cover_w }}×{{ block.settings.cover_l }} cm</strong></p>
            <dl class="nd-finder__list">
              {%- if block.settings.pillow != blank -%}<div><dt>Taies</dt><dd>{{ block.settings.pillow | escape }}</dd></div>{%- endif -%}
              {%- if block.settings.fitted != blank -%}<div><dt>Drap-housse</dt><dd>{{ block.settings.fitted | escape }}</dd></div>{%- endif -%}
              {%- assign overhang = block.settings.cover_w | minus: block.settings.bed_w | divided_by: 2 -%}
              {%- if overhang > 0 -%}<div><dt>Retombée sur les côtés</dt><dd>≈ {{ overhang }} cm de chaque côté</dd></div>{%- endif -%}
              {%- if block.settings.alt != blank -%}<div><dt>Plus enveloppant</dt><dd>{{ block.settings.alt | escape }}</dd></div>{%- endif -%}
            </dl>
            {%- if block.settings.note != blank -%}<p class="nd-finder__note">{{ block.settings.note | escape }}</p>{%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <p class="nd-finder__tip">{{ section.settings.tip | escape }}</p>
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling.querySelector('[data-nd-finder]');
    if (!root) return;
    root.classList.add('is-enhanced');
    var radios = root.querySelectorAll('.nd-seg input');
    var answers = root.querySelectorAll('.nd-finder__answer');
    var track = root.querySelector('.nd-seg__track');
    var stage = root.querySelector('.nd-finder__stage');
    var dimW = root.querySelector('[data-dim-w]');
    var dimL = root.querySelector('[data-dim-l]');
    function show(i) {
      var a = answers[i]; if (!a) return;
      answers.forEach(function (el) { if (el === a) { el.setAttribute('aria-current', 'true'); } else { el.removeAttribute('aria-current'); } });
      // Le schéma part de sa position actuelle : on peut changer d'avis en plein mouvement
      var s = root.style;
      s.setProperty('--bw', a.dataset.bedW);
      s.setProperty('--bl', a.dataset.bedL);
      s.setProperty('--cw', a.dataset.coverW);
      s.setProperty('--cl', a.dataset.coverL);
      stage.classList.toggle('is-single', Number(a.dataset.bedW) < 120);
      dimW.textContent = a.dataset.coverW + ' cm';
      dimL.textContent = a.dataset.coverL + ' cm';
      var opt = radios[i].closest('.nd-seg__option');
      track.style.setProperty('--thumb-x', opt.offsetLeft + 'px');
      track.style.setProperty('--thumb-w', opt.offsetWidth + 'px');
    }
    radios.forEach(function (r, i) {
      // Réponse dès l'appui (pointerdown), pas au relâchement
      r.closest('.nd-seg__option').addEventListener('pointerdown', function () { r.checked = true; show(i); });
      r.addEventListener('change', function () { show(i); });
    });
    var current = Array.prototype.findIndex.call(radios, function (r) { return r.checked; });
    show(current < 0 ? 0 : current);
    window.addEventListener('resize', function () {
      var c = Array.prototype.findIndex.call(radios, function (r) { return r.checked; });
      show(c < 0 ? 0 : c);
    });
  })();
</script>

{% schema %}
{
  "name": "Trouver ma taille",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Guide des tailles" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez la bonne taille en un geste" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "text", "id": "question", "label": "Question", "default": "Mon lit mesure…" },
    { "type": "range", "id": "default_index", "label": "Taille sélectionnée au départ (n° du bloc, à partir de 0)", "min": 0, "max": 5, "step": 1, "default": 1 },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir les parures" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "tip", "label": "Conseil en bas", "default": "La housse doit avoir la même taille que votre couette : en cas de doute, mesurez votre couette." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    {
      "type": "bed",
      "name": "Taille de lit",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé du bouton", "default": "140" },
        { "type": "number", "id": "bed_w", "label": "Largeur du matelas (cm)", "default": 140 },
        { "type": "number", "id": "bed_l", "label": "Longueur du matelas (cm)", "default": 190 },
        { "type": "number", "id": "cover_w", "label": "Largeur de la housse (cm)", "default": 200 },
        { "type": "number", "id": "cover_l", "label": "Longueur de la housse (cm)", "default": 200 },
        { "type": "text", "id": "pillow", "label": "Taies conseillées", "default": "2 × 65×65 cm" },
        { "type": "text", "id": "fitted", "label": "Drap-housse", "default": "140×190 cm" },
        { "type": "text", "id": "alt", "label": "Option plus enveloppante" },
        { "type": "text", "id": "note", "label": "Remarque" }
      ]
    }
  ],
  "presets": [{ "name": "Trouver ma taille", "blocks": [{ "type": "bed" }] }]
}
{% endschema %}
