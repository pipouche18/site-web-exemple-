{% comment %} Guide des tailles : tableau housse de couette ↔ lit, modifiable ligne par ligne. {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="rte">{{ section.settings.intro }}</div>
    {%- endif -%}
    <div class="nd-table-wrap" role="region" aria-label="{{ section.settings.heading | default: 'Tableau des tailles' | escape }}" tabindex="0">
      <table class="nd-table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_1 | escape }}</th>
            <th scope="col">{{ section.settings.col_2 | escape }}</th>
            <th scope="col">{{ section.settings.col_3 | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.size | escape }}</th>
              <td>{{ block.settings.bed | escape }}</td>
              <td>{{ block.settings.note | escape }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}
      <div class="rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tableau des tailles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Housses de couette" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "col_1", "label": "Colonne 1", "default": "Taille de housse" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Taille de lit" },
    { "type": "text", "id": "col_3", "label": "Colonne 3", "default": "Bon à savoir" },
    { "type": "richtext", "id": "footnote", "label": "Note sous le tableau" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 36 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "size", "label": "Taille", "default": "200×200 cm" },
        { "type": "text", "id": "bed", "label": "Lit", "default": "140×190 ou 140×200 cm" },
        { "type": "text", "id": "note", "label": "Remarque" }
      ]
    }
  ],
  "presets": [{ "name": "Tableau des tailles", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
