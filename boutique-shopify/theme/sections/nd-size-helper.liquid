{% comment %} Aide au choix de la taille : « Mon lit fait… → votre housse ». {% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .nd-sizes__wrap { display: grid; gap: 3.2rem; align-items: center; }
  @media screen and (min-width: 990px) { .nd-sizes__wrap { grid-template-columns: 1fr 1.6fr; gap: 6.4rem; } }
  .nd-sizes__intro .rte { margin-bottom: 2.4rem; }
  .nd-sizes__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.6rem; margin: 0; padding: 0; list-style: none; }
  .nd-size { display: block; height: 100%; padding: 2.4rem 2rem; border: 1px solid rgba(var(--color-foreground), .2); text-decoration: none; color: inherit; transition: background .3s ease; }
  .nd-size:hover, .nd-size:focus-visible { background: rgba(var(--color-foreground), .05); }
  .nd-size__bed { display: block; font-size: 1.2rem; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 1.2rem; }
  .nd-size__arrow { display: block; margin: 0 0 1rem; opacity: .6; }
  .nd-size__cover { display: block; font-family: var(--font-heading-family); font-size: 2.8rem; line-height: 1.1; }
  .nd-size__note { display: block; margin-top: .8rem; font-size: 1.35rem; color: rgba(var(--color-foreground), .75); }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="nd-sizes__wrap">
      <div class="nd-sizes__intro">
        {%- if section.settings.kicker != blank -%}<p class="nd-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
      <ul class="nd-sizes__grid" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="nd-size" href="{{ block.settings.link | default: section.settings.button_link | default: '#' }}">
              <span class="nd-size__bed">{{ block.settings.bed | escape }}</span>
              <span class="nd-size__arrow" aria-hidden="true">↓</span>
              <span class="nd-size__cover">{{ block.settings.cover | escape }}</span>
              {%- if block.settings.note != blank -%}<span class="nd-size__note">{{ block.settings.note | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Aide au choix de taille",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Le bon format" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quelle taille pour mon lit ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir le guide des tailles" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Taille",
      "settings": [
        { "type": "text", "id": "bed", "label": "Lit", "default": "Lit 140" },
        { "type": "text", "id": "cover", "label": "Housse conseillée", "default": "200×200 cm" },
        { "type": "text", "id": "note", "label": "Remarque" },
        { "type": "url", "id": "link", "label": "Lien (facultatif)" }
      ]
    }
  ],
  "presets": [{ "name": "Aide au choix de taille", "blocks": [{ "type": "size" }, { "type": "size" }, { "type": "size" }] }]
}
{% endschema %}
