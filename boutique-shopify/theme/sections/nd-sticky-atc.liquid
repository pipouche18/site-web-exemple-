{% comment %}
  Barre d'achat collante : apparaît quand le bouton « Ajouter au panier » principal
  n'est plus visible (surtout utile sur téléphone). Elle clique le vrai bouton,
  donc la couleur et la taille choisies sont respectées.
{% endcomment %}
{%- if product -%}
  {%- style -%}
    .nd-sticky { position: fixed; z-index: 3; left: 0; right: 0; bottom: 0; transform: translateY(110%); transition: transform .3s ease; border-top: 1px solid rgba(var(--color-foreground), .12); box-shadow: 0 -4px 16px rgba(0,0,0,.06); }
    .nd-sticky.is-visible { transform: none; }
    .nd-sticky__inner { display: flex; align-items: center; gap: 1.2rem; padding: 1rem 1.6rem; }
    .nd-sticky__info { flex: 1; min-width: 0; }
    .nd-sticky__title { margin: 0; font-family: var(--font-heading-family); font-size: 1.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nd-sticky__price { margin: 0; font-size: 1.4rem; }
    .nd-sticky .button { min-height: 4.6rem; padding: 0 2rem; flex: none; }
    @media screen and (min-width: 990px) { .nd-sticky__inner { max-width: var(--page-width); margin: 0 auto; padding: 1.2rem 5rem; } }
    @media (prefers-reduced-motion: reduce) { .nd-sticky { transition: none; } }
  {%- endstyle -%}
  <div class="nd-sticky color-{{ section.settings.color_scheme }} gradient" data-nd-sticky aria-hidden="true">
    <div class="nd-sticky__inner">
      <div class="nd-sticky__info">
        <p class="nd-sticky__title">{{ product.title | escape }}</p>
        <p class="nd-sticky__price" data-nd-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      </div>
      <button type="button" class="button" data-nd-sticky-button tabindex="-1">{{ section.settings.label | escape }}</button>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var bar = document.querySelector('[data-nd-sticky]');
      var target = document.querySelector('product-form button[name="add"]');
      if (!bar || !target || !('IntersectionObserver' in window)) return;
      var btn = bar.querySelector('[data-nd-sticky-button]');
      var price = bar.querySelector('[data-nd-sticky-price]');
      new IntersectionObserver(function (entries) {
        var hidden = !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0;
        bar.classList.toggle('is-visible', hidden);
        bar.setAttribute('aria-hidden', hidden ? 'false' : 'true');
        btn.tabIndex = hidden ? 0 : -1;
        document.body.style.paddingBottom = hidden ? bar.offsetHeight + 'px' : '';
      }).observe(target);
      btn.addEventListener('click', function () {
        target.click();
      });
      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
        subscribe(PUB_SUB_EVENTS.variantChange, function (e) {
          var v = e.data && e.data.variant;
          if (!v) return;
          var p = e.data.html && e.data.html.querySelector('#price-' + e.data.sectionId + ' .price-item--last');
          if (p) price.textContent = p.textContent.trim();
          btn.disabled = !v.available;
        });
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'achat collante",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "label", "label": "Texte du bouton", "default": "Ajouter au panier" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Barre d'achat collante" }]
}
{% endschema %}
