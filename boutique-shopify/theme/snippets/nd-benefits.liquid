{% comment %}
  Trois points forts courts sous le prix (fiche produit).
  Source : champ produit « Points forts » (custom.points_forts, une ligne par point),
  sinon les textes par défaut du bloc. Uniquement des informations confirmées.
{% endcomment %}
{%- liquid
  assign lines = product.metafields.custom.points_forts.value | newline_to_br | split: '<br />'
  assign has_mf = false
  if product.metafields.custom.points_forts.value != blank
    assign has_mf = true
  endif
-%}
<ul class="nd-benefits list-unstyled" role="list" {{ block.shopify_attributes }}>
  {%- if has_mf -%}
    {%- for l in lines limit: 4 -%}
      {%- assign t = l | strip -%}
      {%- if t != blank -%}
        <li><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8.5l3.2 3L13 4.5"/></svg>{{ t | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..3) -%}
      {%- assign key = 'b' | append: i -%}
      {%- if block.settings[key] != blank -%}
        <li><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8.5l3.2 3L13 4.5"/></svg>{{ block.settings[key] | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</ul>
