{% comment %}
  Panier : « C'est pour offrir ? » + message cadeau, enregistré dans les attributs du panier
  (visible dans le détail de la commande, dans l'administration Shopify).
{% endcomment %}
{%- assign gift_on = false -%}
{%- if cart.attributes['Cadeau'] == 'Oui' -%}{%- assign gift_on = true -%}{%- endif -%}
<details class="nd-gift"{% if gift_on %} open{% endif %}>
  <summary class="nd-gift__toggle">
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M12 8v13M3 12h18M12 8c-2-3.5-6-3.5-6-1s3 1 6 1zm0 0c2-3.5 6-3.5 6-1s-3 1-6 1z"/></svg>
    <span>C'est pour offrir ?</span>
  </summary>
  <div class="nd-gift__body">
    <label class="nd-gift__label" for="NdGiftMsg">Votre message (facultatif)</label>
    <textarea id="NdGiftMsg" class="nd-gift__msg" rows="3" maxlength="300" placeholder="Joyeux anniversaire ! Avec toute notre tendresse…" data-nd-gift>{{ cart.attributes['Message cadeau'] }}</textarea>
    <p class="nd-gift__hint">Votre message est enregistré avec votre commande.</p>
  </div>
</details>
<script>
  (function () {
    if (window.ndGiftInit) return; window.ndGiftInit = true;
    var t;
    function save(on, msg) {
      fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/update.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: { 'Cadeau': on ? 'Oui' : '', 'Message cadeau': on ? msg : '' } })
      });
    }
    document.addEventListener('toggle', function (e) {
      var d = e.target; if (!d.classList || !d.classList.contains('nd-gift')) return;
      var ta = d.querySelector('[data-nd-gift]'); save(d.open, ta ? ta.value : '');
    }, true);
    document.addEventListener('input', function (e) {
      if (!e.target.matches('[data-nd-gift]')) return;
      clearTimeout(t); var v = e.target.value;
      t = setTimeout(function () { save(true, v); }, 500);
    });
  })();
</script>
