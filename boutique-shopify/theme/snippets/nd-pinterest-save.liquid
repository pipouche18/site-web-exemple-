{% comment %}
  Bouton « Enregistrer sur Pinterest » : simple lien de partage,
  sans script Pinterest (aucun traceur, aucun ralentissement).
  Paramètres : product
{% endcomment %}
{%- if settings.pinterest_save_button and product.featured_media != blank -%}
  {%- liquid
    assign pin_url = product.url | prepend: request.origin | url_encode
    assign pin_media = product.featured_media | image_url: width: 1200 | prepend: 'https:' | url_encode
    assign pin_desc = product.title | append: ' – ' | append: shop.name | url_encode
  -%}
  <a
    class="nd-pin"
    href="https://www.pinterest.com/pin/create/button/?url={{ pin_url }}&media={{ pin_media }}&description={{ pin_desc }}"
    target="_blank"
    rel="noopener"
    data-nd-pin
  >
    <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.64 19.31c-.09-.78-.17-1.98.03-2.83l1.17-4.97s-.3-.6-.3-1.48c0-1.39.81-2.43 1.81-2.43.86 0 1.27.64 1.27 1.41 0 .86-.55 2.15-.83 3.34-.24 1 .5 1.81 1.48 1.81 1.78 0 3.15-1.88 3.15-4.58 0-2.4-1.72-4.07-4.18-4.07-2.85 0-4.52 2.13-4.52 4.34 0 .86.33 1.78.74 2.28a.3.3 0 0 1 .07.29l-.28 1.13c-.04.18-.15.22-.33.13-1.25-.58-2.03-2.4-2.03-3.87 0-3.15 2.29-6.04 6.6-6.04 3.46 0 6.16 2.47 6.16 5.77 0 3.45-2.17 6.22-5.19 6.22-1.01 0-1.97-.53-2.29-1.15l-.62 2.38c-.23.87-.84 1.96-1.25 2.62A10 10 0 1 0 12 2z"/></svg>
    <span>Enregistrer</span>
    <span class="visually-hidden">sur Pinterest (nouvelle fenêtre)</span>
  </a>
{%- endif -%}
