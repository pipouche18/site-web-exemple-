  {
    "name": "Maison Lettrine",
    "settings": [
      {
        "type": "header",
        "content": "Livraison"
      },
      {
        "type": "paragraph",
        "content": "Délais utilisés pour « Commandé aujourd'hui, reçu entre le … et le … » (fiche produit) et pour le rappel dans le panier. Un produit peut avoir ses propres délais via les métachamps custom.delai_min et custom.delai_max."
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "label": "Délai minimum (jours)",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 10
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "label": "Délai maximum (jours)",
        "min": 1,
        "max": 45,
        "step": 1,
        "default": 16
      },
      {
        "type": "checkbox",
        "id": "delivery_business_days",
        "label": "Compter en jours ouvrés (hors samedi et dimanche)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "delivery_to_confirm",
        "label": "Afficher « [à confirmer] » après les délais",
        "default": true,
        "info": "Décochez quand les délais sont validés."
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Livraison offerte dès (€)",
        "default": 50,
        "info": "Barre de progression du panier. Mettez 0 pour la masquer. Le tarif lui-même se règle dans Paramètres > Expédition."
      },
      {
        "type": "header",
        "content": "Suggestion dans le panier"
      },
      {
        "type": "paragraph",
        "content": "Produit proposé en un clic dans le panier (la recharge de cire). Il disparaît s'il est déjà dans le panier."
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Produit suggéré"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Titre de la suggestion",
        "default": "Un peu plus de cire ?"
      },
      {
        "type": "text",
        "id": "cart_upsell_text",
        "label": "Phrase de la suggestion",
        "default": "Une recharge ≈ 50 cachets de plus."
      },
      {
        "type": "header",
        "content": "Personnalisation"
      },
      {
        "type": "text",
        "id": "engraving_tag",
        "label": "Tag des produits gravés sur mesure",
        "default": "mariage",
        "info": "Ces produits affichent la mention d'exclusion du droit de rétractation (art. L221-28, 3° du Code de la consommation) sur la fiche et au panier."
      },
      {
        "type": "textarea",
        "id": "wax_colors",
        "label": "Couleurs des cires",
        "info": "Pastilles des variantes et aperçu du cachet. Une ligne par couleur : nom de la variante = code couleur (ou « multi » pour un mélange).",
        "default": "Bordeaux = #8E1F2B\nTerracotta = #B5583A\nSauge = #8A9A7B\nOr = #C9A54A\nBlanc ivoire = #EDE6D6\nBleu nuit = #26324A\nMélange 10 couleurs = multi"
      },
      {
        "type": "header",
        "content": "Partage et Pinterest"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage par défaut",
        "info": "Utilisée par Pinterest et les réseaux quand une page n'a pas de photo. Format conseillé : 1000 × 1500 px."
      },
      {
        "type": "checkbox",
        "id": "pinterest_save_button",
        "label": "Bouton « Enregistrer » Pinterest sur les photos produit",
        "default": true,
        "info": "Simple lien, sans script Pinterest : aucun traceur chargé."
      },
      {
        "type": "paragraph",
        "content": "Balise Pinterest et API de conversions : installez l'appli officielle « Pinterest » depuis l'App Store Shopify. Elle respecte la bannière de consentement. Ne collez aucun code de suivi dans le thème."
      },
      {
        "type": "header",
        "content": "Cookies"
      },
      {
        "type": "checkbox",
        "id": "show_cookie_preferences_link",
        "label": "Lien « Gérer mes cookies » dans le pied de page",
        "default": true,
        "info": "Rouvre la bannière de consentement de Shopify (Paramètres > Confidentialité client)."
      }
    ]
