{%- comment -%}
  « Un cachet en 4 gestes » : étapes numérotées + emplacement vidéo
  (vidéo hébergée sur Shopify ou lien YouTube / Vimeo, chargé au clic).
{%- endcomment -%}
{%- render 'ml-section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}
{%- liquid
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- render 'ml-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      text: section.settings.text
    -%}
    <div class="ml-steps-layout{% if has_video %} ml-steps-layout--video{% endif %}">
      {%- if has_video -%}
        <div class="ml-steps__video">
          {%- if video != blank -%}
            {{
              video
              | video_tag:
                controls: true,
                playsinline: true,
                preload: 'none',
                image_size: '1200x',
                class: 'ml-video'
            }}
          {%- else -%}
            {{- 'component-deferred-media.css' | asset_url | stylesheet_tag -}}
            <deferred-media class="deferred-media ml-video-frame" data-media-id="{{ section.id }}">
              <button
                id="Deferred-Poster-{{ section.id }}"
                class="deferred-media__poster"
                type="button"
              >
                {%- if section.settings.cover != blank -%}
                  {{
                    section.settings.cover
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: ''
                  }}
                {%- endif -%}
                <span class="ml-video-frame__play">
                  {%- render 'ml-icon', icon: 'play', size: 56 -%}
                  <span class="visually-hidden">{{ 'ml.steps.play_video' | t }}</span>
                </span>
              </button>
              <template>
                {%- if video_url.type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube-nocookie.com/embed/{{ video_url.id }}?autoplay=1&rel=0"
                    title="{{ section.settings.heading | strip_html | escape }}"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                  ></iframe>
                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1&dnt=1"
                    title="{{ section.settings.heading | strip_html | escape }}"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                  ></iframe>
                {%- endif -%}
              </template>
            </deferred-media>
          {%- endif -%}
        </div>
      {%- endif -%}
      <ol class="ml-steps" role="list">
        {%- for block in section.blocks -%}
          <li class="ml-step" {{ block.shopify_attributes }}>
            <span class="ml-step__number" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="ml-step__title">
                <span class="visually-hidden">{{ 'ml.steps.step' | t: number: forloop.index }}</span>
                {{- block.settings.title | escape -}}
              </h3>
              {%- if block.settings.text != blank -%}
                <div class="ml-step__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="ml-center ml-mt">
        <a class="button button--secondary" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Étapes (vidéo)",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "La méthode" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Un cachet en 4 gestes" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "video", "id": "video", "label": "Vidéo hébergée sur Shopify" },
    { "type": "video_url", "id": "video_url", "label": "Ou lien YouTube / Vimeo", "accept": ["youtube", "vimeo"], "info": "Chargée seulement au clic (aucun cookie avant)." },
    { "type": "image_picker", "id": "cover", "label": "Image de couverture de la vidéo YouTube / Vimeo" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Lire le guide complet" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Chauffer la cire" },
        { "type": "richtext", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Étapes (vidéo)", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
