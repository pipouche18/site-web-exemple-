{%- comment -%}
  Partie de guide, avec ancre pour le sommaire. Trois mises en page :
  - « steps » : étapes numérotées illustrées (photo facultative) ;
  - « errors » : erreur → cause → solution ;
  - « list » : liste numérotée simple (ex. méthode La Poste).
{%- endcomment -%}
{%- render 'ml-section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}
{%- assign layout = section.settings.layout -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if layout != 'steps' %} page-width--narrow{% endif %}"
    id="{{ section.settings.anchor | handleize }}"
  >
    {%- render 'ml-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'left'
    -%}
    <ol class="ml-guide ml-guide--{{ layout }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ml-guide__item" {{ block.shopify_attributes }}>
          {%- if layout == 'steps' -%}
            <div class="ml-guide__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 92vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt | default: block.settings.title
                  }}
              {%- else -%}
                <span class="ml-guide__placeholder" aria-hidden="true">{{ forloop.index }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="ml-guide__body">
            <h3 class="ml-guide__title">
              <span class="ml-guide__number" aria-hidden="true">{{ forloop.index }}</span>
              {{- block.settings.title | escape -}}
            </h3>
            {%- if block.settings.text != blank -%}
              <div class="ml-guide__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if layout == 'errors' and block.settings.solution != blank -%}
              <div class="ml-guide__solution rte">
                <p class="ml-guide__solution-label">{%- render 'ml-icon', icon: 'check', size: 16 -%}{{ 'ml.guide.solution' | t }}</p>
                {{ block.settings.solution }}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank -%}
      <div class="ml-article__note rte">{{ section.settings.note }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="ml-mt"><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Partie de guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (pour le sommaire)", "default": "pas-a-pas" },
    {
      "type": "select",
      "id": "layout",
      "label": "Mise en page",
      "options": [
        { "value": "steps", "label": "Étapes illustrées" },
        { "value": "errors", "label": "Erreurs et solutions" },
        { "value": "list", "label": "Liste numérotée" }
      ],
      "default": "steps"
    },
    { "type": "text", "id": "kicker", "label": "Surtitre" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Pas à pas" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "richtext", "id": "note", "label": "Encadré sous la liste" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 56 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (étapes illustrées)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Préparer" },
        { "type": "richtext", "id": "text", "label": "Texte (ou cause de l'erreur)" },
        { "type": "richtext", "id": "solution", "label": "Solution (erreurs et solutions)" }
      ]
    }
  ],
  "presets": [{ "name": "Partie de guide", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
