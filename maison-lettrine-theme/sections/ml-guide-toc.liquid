{%- comment -%}
  Sommaire cliquable d'une page longue (guide). Chaque lien pointe vers
  l'ancre réglée dans la section visée (réglage « Ancre »).
{%- endcomment -%}
{%- render 'ml-section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <nav class="ml-toc" aria-labelledby="Toc-{{ section.id }}">
      <p class="ml-toc__title" id="Toc-{{ section.id }}">{{ section.settings.heading | escape }}</p>
      <ol class="ml-toc__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="#{{ block.settings.anchor | handleize }}">
              <span class="ml-toc__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {{ block.settings.label | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Sommaire",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Sommaire" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 32 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Lien",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Pas à pas" },
        { "type": "text", "id": "anchor", "label": "Ancre visée", "default": "pas-a-pas", "info": "Identique au réglage « Ancre » de la section." }
      ]
    }
  ],
  "presets": [{ "name": "Sommaire", "blocks": [{ "type": "link" }] }]
}
{% endschema %}
