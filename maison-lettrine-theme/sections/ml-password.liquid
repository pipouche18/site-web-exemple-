{%- comment -%}
  Page mot de passe (boutique pas encore ouverte) : logo, promesse et
  formulaire « Être prévenue de l'ouverture » (inscription newsletter Shopify).
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ml-password">
    {%- if section.settings.seal != blank -%}
      <div class="ml-password__seal">
        {{
          section.settings.seal
          | image_url: width: 480
          | image_tag: widths: '160, 240, 320, 480', sizes: '160px', loading: 'eager', alt: section.settings.seal.alt
        }}
      </div>
    {%- endif -%}
    {%- if section.settings.kicker != blank -%}
      <p class="ml-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h1 class="ml-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="ml-head__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordSignup', class: 'ml-password__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, ouverture">
      {%- if form.posted_successfully? -%}
        <p class="ml-signup__success" role="status" tabindex="-1" autofocus>
          {%- render 'ml-icon', icon: 'check', size: 20 -%}
          {{ section.settings.success | escape }}
        </p>
      {%- else -%}
        <div class="ml-field">
          <label for="PasswordSignupEmail">{{ 'ml.signup.email_label' | t }}</label>
          <div class="ml-signup__row">
            <input
              id="PasswordSignupEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              placeholder="{{ 'ml.signup.email_placeholder' | t }}"
              {% if form.errors %}
                aria-invalid="true" aria-describedby="PasswordSignupError"
              {% endif %}
            >
            <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
          </div>
        </div>
        {%- if form.errors -%}
          <p id="PasswordSignupError" class="ml-signup__error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Ouverture prochaine",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "seal", "label": "Cachet ou logo" },
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Bientôt" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Ouverture très bientôt" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Être prévenue de l'ouverture" },
    { "type": "text", "id": "success", "label": "Message de confirmation", "default": "Merci ! Nous vous écrivons dès l'ouverture." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" }
  ]
}
{% endschema %}
