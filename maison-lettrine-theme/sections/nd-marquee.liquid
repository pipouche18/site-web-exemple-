{% comment %} Bandeau défilant de mots-clés (s'arrête si l'utilisatrice préfère moins d'animations). {% endcomment %}
{%- liquid
  assign items = section.settings.items | split: '|'
-%}
{%- style -%}
  .nd-marquee-{{ section.id }} { overflow: hidden; padding: 1.4rem 0; border-top: 1px solid rgba(var(--color-foreground), .12); border-bottom: 1px solid rgba(var(--color-foreground), .12); }
  .nd-marquee-{{ section.id }} .nd-marquee__track { display: flex; width: max-content; animation: nd-marquee-{{ section.id }} {{ section.settings.speed }}s linear infinite; }
  .nd-marquee-{{ section.id }} .nd-marquee__group { display: flex; flex-shrink: 0; }
  .nd-marquee-{{ section.id }} .nd-marquee__item { display: inline-flex; align-items: center; gap: 2.4rem; padding-right: 2.4rem; white-space: nowrap; font-family: var(--font-heading-family); font-style: italic; font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .nd-marquee-{{ section.id }} .nd-marquee__item::after { content: '✦'; font-style: normal; font-size: 1.2rem; opacity: .7; }
  @keyframes nd-marquee-{{ section.id }} { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .nd-marquee-{{ section.id }} .nd-marquee__track { animation: none; } }
{%- endstyle -%}
<div class="nd-marquee-{{ section.id }} color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="{{ items | join: ', ' | escape }}">
  <div class="nd-marquee__track" aria-hidden="true">
    {%- for n in (1..2) -%}
      <div class="nd-marquee__group">
        {%- for r in (1..3) -%}
          {%- for item in items -%}<span class="nd-marquee__item">{{ item | strip | escape }}</span>{%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bandeau défilant",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "items", "label": "Mots (séparés par |)", "default": "Coton lavé | Double gaze | Sans repassage | Livraison suivie | 14 jours pour changer d'avis" },
    { "type": "range", "id": "speed", "label": "Durée d'un tour (secondes)", "min": 20, "max": 80, "step": 5, "default": 40 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-6" }
  ],
  "presets": [{ "name": "Bandeau défilant" }]
}
{% endschema %}
