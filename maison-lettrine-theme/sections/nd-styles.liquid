{% comment %}
  « Trouver mon style » : une carte par collection. Utilise l'image de la
  collection si elle existe, sinon une tuile de couleur unie (pas d'illustration).
{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .nd-styles__grid { display: grid; grid-template-columns: 1fr; gap: 1.6rem; margin: 2.4rem 0 0; padding: 0; list-style: none; }
  @media screen and (min-width: 750px) { .nd-styles__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr); gap: 2.4rem; } }
  .nd-style-card { position: relative; display: flex; align-items: flex-end; aspect-ratio: 4 / 5; overflow: hidden; text-decoration: none; color: inherit; }
  @media screen and (max-width: 749px) { .nd-style-card { aspect-ratio: 16 / 10; } }
  .nd-style-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .nd-style-card:hover img { transform: scale(1.03); }
  .nd-style-card--photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(30,24,20,.55), transparent 60%); }
  .nd-style-card__body { position: relative; z-index: 1; padding: 2.4rem; }
  .nd-style-card--photo .nd-style-card__body, .nd-style-card--photo .nd-style-card__body * { color: #fff; }
  .nd-style-card__title { margin: 0 0 .6rem; font-size: clamp(2.6rem, 5vw, 3.4rem); }
  .nd-style-card__text { margin: 0 0 1rem; font-size: 1.5rem; }
  .nd-style-card__link { font-size: 1.3rem; letter-spacing: .14em; text-transform: uppercase; text-decoration: underline; text-underline-offset: .4rem; }
  .nd-style-card:focus-visible { outline: 2px solid rgb(var(--color-foreground)); outline-offset: 3px; }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}<h2 class="h1 center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <ul class="nd-styles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign title = block.settings.title | default: c.title -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ c.url | default: '#' }}" class="nd-style-card color-{{ block.settings.color_scheme }}{% if c.image != blank %} nd-style-card--photo{% endif %}">
            {%- if c.image != blank -%}
              {{ c.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: c.image.alt | default: title }}
            {%- endif -%}
            <div class="nd-style-card__body">
              <h3 class="nd-style-card__title">{{ title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="nd-style-card__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              <span class="nd-style-card__link">Découvrir</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trouver mon style",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouver mon style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs de la section", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 48 }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre (facultatif)" },
        { "type": "text", "id": "text", "label": "Courte phrase" },
        { "type": "color_scheme", "id": "color_scheme", "label": "Couleur de la carte (sans photo)", "default": "scheme-2" }
      ]
    }
  ],
  "presets": [{ "name": "Trouver mon style", "blocks": [{ "type": "style" }, { "type": "style" }, { "type": "style" }] }]
}
{% endschema %}
