{%- comment -%}
  Barre de progression vers la livraison offerte (seuil en euros réglé dans
  Paramètres du thème > Maison Lettrine). Recalculée à chaque mise à jour du panier.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign total = cart.total_price
-%}
{%- if threshold > 0 and cart != empty -%}
  {%- liquid
    assign remaining = threshold | minus: total
    assign percent = total | times: 100 | divided_by: threshold | at_most: 100
  -%}
  <div class="ml-ship{% if remaining <= 0 %} ml-ship--done{% endif %}">
    <p class="ml-ship__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'ml.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {%- render 'ml-icon', icon: 'check', size: 16 -%}
        {{ 'ml.cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div
      class="ml-ship__bar"
      role="progressbar"
      aria-label="{{ 'ml.cart.free_shipping_label' | t }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ percent }}"
    >
      <span class="ml-ship__fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
