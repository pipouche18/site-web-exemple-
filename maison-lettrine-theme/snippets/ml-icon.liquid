{%- comment -%}
  Icônes au trait de Maison Lettrine (SVG en ligne, aucune requête).
  Paramètres :
  - icon : nom de l'icône (guide, wax, box, chat, seal, truck, lock, return, check, cross, gift, rings, baby, envelope, pen, flame, snow, play)
  - size : taille en px (24 par défaut)
{%- endcomment -%}
{%- assign size = size | default: 24 -%}
<svg
  class="ml-icon ml-icon--{{ icon }}"
  aria-hidden="true"
  focusable="false"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case icon -%}
    {%- when 'guide' -%}
      <path d="M12 6.5C10.2 5 7.6 4.5 4 4.5v13c3.6 0 6.2.5 8 2 1.8-1.5 4.4-2 8-2v-13c-3.6 0-6.2.5-8 2z"/><path d="M12 6.5v13"/>
    {%- when 'wax' -%}
      <path d="M12 3.5c3.2 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.3-6 5.5-10z"/><path d="M9.5 14.5a2.6 2.6 0 0 0 2.5 2.4"/>
    {%- when 'box' -%}
      <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5 12 11.5l8.5-4"/><path d="M12 11.5v9"/>
    {%- when 'chat' -%}
      <path d="M4.5 5.5h15v10h-8l-4.5 3.5v-3.5H4.5z"/><path d="M8.5 9.5h7M8.5 12h4.5"/>
    {%- when 'seal' -%}
      <path d="M12 3.2c2.3 0 3 1.3 4.7 1.9 1.8.6 3.3 1.6 3.4 3.8.1 1.9-.8 2.6-.8 4.2 0 1.8 1.1 2.9.2 4.6-1 1.9-3.1 1.8-4.6 2.7-1.4.8-2 1.9-4 1.9s-2.8-1.1-4.4-1.8c-1.7-.8-3.6-1-4.3-2.9-.6-1.6.4-2.8.4-4.5S1.9 10 2.8 8.3c1-1.9 2.6-2.4 4.2-3.1C8.7 4.4 9.6 3.2 12 3.2z"/><circle cx="12" cy="12" r="5.2"/><path d="M10.6 9.6v4.8h2.9"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7z"/><circle cx="6.5" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="9.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14v2.5"/>
    {%- when 'return' -%}
      <path d="M8.5 5 4.5 9l4 4"/><path d="M4.5 9h10a5 5 0 0 1 0 10h-5"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'cross' -%}
      <path d="m6.5 6.5 11 11M17.5 6.5l-11 11"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8.5" width="17" height="4"/><path d="M5 12.5v8h14v-8"/><path d="M12 8.5v12"/><path d="M12 8.5C10.5 5 7 4.5 7 6.6 7 8.5 12 8.5 12 8.5zM12 8.5c1.5-3.5 5-4 5-1.9 0 1.9-5 1.9-5 1.9z"/>
    {%- when 'rings' -%}
      <circle cx="9" cy="14" r="5.5"/><circle cx="15" cy="14" r="5.5"/><path d="m10.5 5 1.5-2 1.5 2-1.5 1.5z"/>
    {%- when 'baby' -%}
      <path d="M5 11.5h14a7 7 0 0 1-14 0z"/><path d="M5 11.5c0-4 3-7 7-7v7"/><circle cx="8" cy="20.5" r="1.3"/><circle cx="16" cy="20.5" r="1.3"/>
    {%- when 'envelope' -%}
      <rect x="3" y="5.5" width="18" height="13"/><path d="m3 6 9 7 9-7"/>
    {%- when 'pen' -%}
      <path d="M14.5 4.5 19.5 9.5 9 20H4v-5z"/><path d="m12.5 6.5 5 5"/>
    {%- when 'flame' -%}
      <path d="M12 3.5c.5 3-3.5 5-3.5 9a3.5 3.5 0 0 0 7 0c0-2-1-3.2-1.8-4.3"/><path d="M12 3.5c3 2.4 6 5.6 6 9.4a6 6 0 0 1-12 0c0-1.7.6-3 1.4-4.2"/>
    {%- when 'snow' -%}
      <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="m9.5 4.5 2.5 2 2.5-2M9.5 19.5l2.5-2 2.5 2"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="9"/><path d="m10 8.5 5.5 3.5-5.5 3.5z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="1.5"/>
  {%- endcase -%}
</svg>
