{%- comment -%}
  Marges haute et basse d'une section (réduites de 25 % sur téléphone).
  Paramètres : id (section.id), top, bottom (en px)
{%- endcomment -%}
{%- style -%}
  .section-{{ id }}-padding {
    padding-top: {{ top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ id }}-padding {
      padding-top: {{ top }}px;
      padding-bottom: {{ bottom }}px;
    }
  }
{%- endstyle -%}
